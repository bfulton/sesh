{
  "description": "sesh: keep every session in your vault after each turn, and run /sesh commands",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/sesh",
            "args": [
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "sesh:sesh",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/sesh",
            "args": [
              "hook"
            ],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
