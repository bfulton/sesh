#!/usr/bin/env bash
# Runs sesh for the Claude Code plugin, installing it on first use.
#
# The Stop hook calls this after every turn, so it must never break a
# session: if sesh can't be installed, the hook does nothing. /sesh and the
# MCP server get the install error instead.
#
# Where the binary comes from, in order: $SESH_BIN, a copy installed here
# earlier, the plugin's pinned release, downloaded and checked against the
# release's SHA256SUMS, or `go install` of that version. A sesh on PATH is
# never used: other tools share the name, and it would skip the pin. Set
# SESH_BIN to use your own build.
set -u

VERSION="${SESH_VERSION:-v0.4.0}"   # a release tag, downloaded, or any module version, built; installed once per value
RELEASES="${SESH_RELEASES:-https://github.com/bfulton/sesh/releases/download}"
DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.sesh/plugin}"
BIN="$DATA/bin/sesh"
STAMP="$DATA/bin/version"

# asset names the release binary for this OS and CPU, as scripts/release-build
# does.
asset() {
  local os arch
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) return 1 ;;
  esac
  if [ "$os" = windows ]; then echo "sesh_${os}_${arch}.exe"; else echo "sesh_${os}_${arch}"; fi
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

# download fetches this version's release binary into $BIN, if it matches the
# release's SHA256SUMS.
download() {
  local name tmp want
  case "$VERSION" in v*) ;; *) echo "$VERSION is not a release tag"; return 1 ;; esac
  name=$(asset) || { echo "no release binary for $(uname -s) $(uname -m)"; return 1; }
  command -v curl >/dev/null 2>&1 || { echo "curl is not installed"; return 1; }
  tmp="$DATA/bin/.download.$$"
  if ! curl -fsSL --max-time 120 -o "$tmp" "$RELEASES/$VERSION/$name"; then
    echo "downloading $name from $RELEASES/$VERSION failed"
    rm -f "$tmp"
    return 1
  fi
  want=$(curl -fsSL --max-time 30 "$RELEASES/$VERSION/SHA256SUMS" | awk -v n="$name" '$2 == n { print $1 }')
  if [ -z "$want" ] || [ "$want" != "$(sha256 "$tmp")" ]; then
    echo "$name doesn't match the release's SHA256SUMS checksum"
    rm -f "$tmp"
    return 1
  fi
  chmod +x "$tmp" && mv -f "$tmp" "$BIN"
}

install() {
  mkdir -p "$DATA/bin" || return 1
  if download >"$DATA/install.log" 2>&1; then
    :
  elif ! command -v go >/dev/null 2>&1; then
    echo "go is not installed" >>"$DATA/install.log"
    return 1
  elif ! GOBIN="$DATA/bin" GOFLAGS=-mod=mod go install "github.com/bfulton/sesh/cmd/sesh@$VERSION" >>"$DATA/install.log" 2>&1; then
    return 1
  fi
  printf '%s\n' "$VERSION" >"$STAMP"
}

pick() {
  if [ -n "${SESH_BIN:-}" ] && [ -x "$SESH_BIN" ]; then echo "$SESH_BIN"; return 0; fi
  if [ -x "$BIN" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$VERSION" ]; then echo "$BIN"; return 0; fi
  install && echo "$BIN"
}

if ! exe=$(pick); then
  if [ "${1:-}" = hook ]; then
    # The Stop hook does nothing; /sesh says why it can't run.
    case "$(cat)" in
      *'"UserPromptExpansion"'*)
        msg="sesh printed this for the user's /sesh command: sesh couldn't be installed: $(tail -1 "$DATA/install.log" 2>/dev/null | tr -d '\000-\037'). Set SESH_BIN to a sesh binary."
        printf '{"hookSpecificOutput":{"hookEventName":"UserPromptExpansion","additionalContext":%s}}\n' "$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')"
        ;;
    esac
    exit 0
  fi
  echo "sesh: couldn't install: $(cat "$DATA/install.log" 2>/dev/null). Set SESH_BIN to a sesh binary." >&2
  exit 1
fi
exec "$exe" "$@"
